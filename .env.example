# axios가 요청을 보낼 주소. 개발은 프록시를 타도록 /api
VITE_API_BASE_URL=/api
# 개발 서버 프록시가 /api 요청을 넘길 백엔드 주소
VITE_API_PROXY_TARGET=https://dang-dang.site
# 카카오 인가 요청용 REST API 키. Client Secret은 백엔드에만 둠
VITE_KAKAO_REST_API_KEY=
# 카카오 콘솔에 등록한 Redirect URI. 비우면 현재 도메인의 /auth/kakao/callback
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
